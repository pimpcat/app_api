{
  "id": "atlas_municipal",
  "product": "atlas_municipal",
  "title": "Atlas municipal — Guerrero",
  "cover_title": "Atlas municipal — Guerrero",
  "cover_subtitle": "GroSIG Cartography Engine · croquis por municipio",
  "footer": "GroSIG Cartography Engine · Atlas municipal · {n_pages} hojas · salida vectorial",
  "page_footer": "GroSIG Cartography Engine · CVE {cve_mun} · {crs} · salida vectorial",
  "page_title": "Croquis municipal — {nomgeo}",
  "description": "Atlas 1.3: PDF multipágina (portada + croquis). Layout compact.",
  "max_map_pages": 90,
  "layout": {
    "preset": "compact",
    "paper": "letter",
    "orientation": "portrait",
    "legend": { "enabled": true, "width": 100, "position": "right" },
    "north": { "enabled": true },
    "scale_bar": { "enabled": true },
    "show_brand_header": true,
    "show_outer_frame": true
  },
  "layers": [
    {
      "id": "municipio",
      "label": "Límite municipal",
      "table": "c_mun",
      "geom_column": "the_geom",
      "filter": { "cve_mun": "{cve_mun}" },
      "limit": 1,
      "legend": true,
      "symbol": {
        "type": "polygon",
        "fill_color": "#D9E8F5",
        "fill_opacity": 0.45,
        "stroke_color": "#1F4E79",
        "stroke_width": 1.4
      }
    },
    {
      "id": "localidades",
      "label": "Localidades",
      "table": "c_loc_punto",
      "geom_column": "the_geom",
      "filter": { "cve_mun": "{cve_mun}" },
      "limit": 800,
      "optional": true,
      "legend": true,
      "labels": {
        "enabled": true,
        "field": "nom_loc",
        "limit": 40
      },
      "symbol": {
        "type": "point",
        "fill_color": "#B03A2E",
        "stroke_color": "#FFFFFF",
        "size": 3.2
      }
    }
  ]
}
