{
  "id": "condensado_estatal",
  "product": "condensado_estatal",
  "title": "CONDENSADO ESTATAL CON MARCO GEOESTADÍSTICO — {nomgeo}",
  "footer": "GroSIG Cartography · Condensado estatal · CRS {crs}",
  "layout": {
    "preset": "grosig_condensado",
    "paper": "plotter_90x120",
    "orientation": "landscape",
    "show_brand_header": false,
    "brand_height": 0,
    "title_height": 0,
    "footer_height": 0,
    "legend": { "enabled": true, "width": 340 },
    "north": { "enabled": false },
    "scale_bar": { "enabled": false }
  },
  "layers": [
    {
      "id": "municipios",
      "label": "Municipio (etiqueta)",
      "table": "mgn.municipios_a",
      "geometry": "polygon",
      "limit": 200,
      "filter": { "cve_ent": "12" },
      "labels": {
        "enabled": true,
        "field": "nomgeo",
        "prefix_field": "cve_mun",
        "format": "newline",
        "case": "title",
        "limit": 90,
        "color": "#4F9A58",
        "bold": true,
        "size": 10.5,
        "anchor": "center"
      },
      "symbol": {
        "type": "polygon",
        "fill": "#FFFFFF",
        "fill_opacity": 0.0,
        "stroke": "#E0E0E0",
        "width": 0.1
      }
    },
    {
      "id": "localidades_urbana",
      "label": "Localidad urbana",
      "table": "mgn.localidades_a",
      "geometry": "polygon",
      "limit": 5000,
      "optional": true,
      "filter": { "ambito": "Urbana" },
      "labels": {
        "enabled": true,
        "field": "nomgeo",
        "prefix_field": "cve_loc",
        "format": "newline",
        "case": "title",
        "limit": 500,
        "color": "#1a1a1a",
        "bold": true,
        "size": 7.0,
        "anchor": "center"
      },
      "symbol": {
        "type": "polygon",
        "fill": "#FFF59D",
        "fill_opacity": 1.0,
        "stroke": "#B2B2B2",
        "width": 0.7
      }
    },
    {
      "id": "cuerpos",
      "label": "Cuerpo de agua perenne",
      "table": "info50k.cuerpos_agua_a",
      "geometry": "polygon",
      "limit": 400,
      "simplify": 150,
      "optional": true,
      "filter": { "condicion": "PERENNE" },
      "labels": {
        "enabled": true,
        "field": "nombre",
        "limit": 120,
        "color": "#00ADEE",
        "bold": false,
        "italic": true,
        "case": "title",
        "size": 6.0,
        "anchor": "center",
        "exclude": ["NINGUNO"]
      },
      "symbol": {
        "type": "polygon",
        "fill": "#7DD4F7",
        "fill_opacity": 0.75,
        "stroke": "#00ADEE",
        "width": 0.5
      }
    },
    {
      "id": "corrientes",
      "label": "Corriente perenne",
      "table": "info50k.corrientes_agua_l",
      "geometry": "line",
      "limit": 2000,
      "simplify": 200,
      "optional": true,
      "filter": { "condicion": "PERENNE" },
      "labels": {
        "enabled": true,
        "field": "nombre",
        "along": true,
        "limit": 350,
        "color": "#00ADEE",
        "bold": false,
        "italic": true,
        "case": "title",
        "size": 6.5,
        "exclude": ["NINGUNO"]
      },
      "symbol": { "type": "line", "stroke": "#00ADEE", "width": 0.85 }
    },
    {
      "id": "carreteras_doble",
      "label": "Carretera (doble línea)",
      "table": "info50k.carreteras_l",
      "geometry": "line",
      "limit": 4000,
      "simplify": 100,
      "optional": true,
      "filter": { "codigo_m": ["3865", "3867", "3868"] },
      "symbol": {
        "type": "line",
        "stroke": "#212121",
        "width": 1.35,
        "decoration": "double"
      }
    },
    {
      "id": "carreteras_dash",
      "label": "Carretera (continua/discontinua)",
      "table": "info50k.carreteras_l",
      "geometry": "line",
      "limit": 4000,
      "simplify": 100,
      "optional": true,
      "filter": { "codigo_m": "3866" },
      "symbol": {
        "type": "line",
        "stroke": "#212121",
        "width": 1.0,
        "dash": [5, 3],
        "decoration": "double_dash"
      }
    },
    {
      "id": "carreteras_otra",
      "label": "Carretera",
      "table": "info50k.carreteras_l",
      "geometry": "line",
      "limit": 5000,
      "simplify": 120,
      "optional": true,
      "filter": { "codigo_m": ["3660", "3860"] },
      "symbol": { "type": "line", "stroke": "#212121", "width": 0.9 }
    },
    {
      "id": "municipios_l",
      "label": "Límite municipal",
      "table": "mgn.municipios_l",
      "geometry": "line",
      "limit": 200,
      "simplify": 80,
      "optional": true,
      "filter": { "cve_ent": "12" },
      "symbol": {
        "type": "line",
        "stroke": "#4F9A58",
        "width": 2.45,
        "dash": [7, 3.5]
      }
    },
    {
      "id": "estados_l",
      "label": "Límite estatal",
      "table": "mgn.estados_l",
      "geometry": "line",
      "limit": 20,
      "simplify": 50,
      "optional": true,
      "filter": { "cve_ent": "12" },
      "symbol": {
        "type": "line",
        "stroke": "#EE1C25",
        "width": 2.4,
        "decoration": "cross"
      }
    },
    {
      "id": "aeropuerto_intl",
      "label": "Aeropuerto internacional",
      "table": "info50k.aeropuertos_p",
      "geometry": "point",
      "limit": 20,
      "optional": true,
      "filter": { "tipo": "INTERNACIONAL" },
      "symbol": {
        "type": "point",
        "fill": "#000000",
        "stroke": "#000000",
        "size": 5.5,
        "marker": "plane"
      }
    },
    {
      "id": "aeropuerto_local",
      "label": "Aeropuerto nacional / local",
      "table": "info50k.aeropuertos_p",
      "geometry": "point",
      "limit": 40,
      "optional": true,
      "filter": { "tipo": "LOCAL" },
      "symbol": {
        "type": "point",
        "fill": "#000000",
        "stroke": "#000000",
        "size": 4.0,
        "marker": "plane"
      }
    }
  ]
}
